<%@ page pageEncoding="UTF-8" %>
<form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${item.categoryId}"><div class="form-grid"><label>Tên danh mục<input name="categoryName" type="text" maxlength="200" required value="${fn:escapeXml(item.categoryName)}"></label><label>URL ảnh<input name="images" type="text" maxlength="500" value="${fn:escapeXml(item.images)}"></label><label>Trạng thái<select name="status"><option value="1" ${empty item or item.status == 1 ? 'selected' : ''}>1 – Hoạt động</option><option value="0" ${not empty item and item.status == 0 ? 'selected' : ''}>0 – Chưa kích hoạt / Khóa</option></select></label></div><button>Lưu dữ liệu</button> <a class="cancel" href="${pageContext.request.contextPath}/admin/categories">Hủy</a></form>