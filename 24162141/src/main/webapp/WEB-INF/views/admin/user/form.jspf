<%@ page pageEncoding="UTF-8" %>
<form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${item.userId}"><div class="form-grid"><label>Tên đăng nhập<input name="username" type="text" maxlength="50" required value="${fn:escapeXml(item.username)}"></label><label>Họ tên<input name="fullname" type="text" maxlength="50" required value="${fn:escapeXml(item.fullname)}"></label><label>Email<input name="email" type="email" maxlength="100" required value="${fn:escapeXml(item.email)}"></label><label>Điện thoại<input name="phone" type="tel" maxlength="20" value="${fn:escapeXml(item.phone)}"></label><label>URL ảnh<input name="images" type="text" maxlength="500" value="${fn:escapeXml(item.images)}"></label><label>Mật khẩu (để trống khi sửa để giữ nguyên)<input name="password" type="password" maxlength="128" autocomplete="new-password"></label><label>Vai trò<select name="roleId" required><c:forEach items="${roles}" var="r"><option value="${r.roleId}" ${item.roleId == r.roleId ? 'selected' : ''}><c:out value="${r.roleName}"/></option></c:forEach></select></label><label>Cửa hàng<select name="sellerId"><option value="">Không thuộc cửa hàng</option><c:forEach items="${sellers}" var="s"><option value="${s.sellerId}" ${item.sellerId == s.sellerId ? 'selected' : ''}><c:out value="${s.sellername}"/></option></c:forEach></select></label><label>Trạng thái<select name="status"><option value="1" ${empty item or item.status == 1 ? 'selected' : ''}>1 – Hoạt động</option><option value="0" ${not empty item and item.status == 0 ? 'selected' : ''}>0 – Chưa kích hoạt / Khóa</option></select></label></div><button>Lưu dữ liệu</button> <a class="cancel" href="${pageContext.request.contextPath}/admin/users">Hủy</a></form>